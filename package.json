{
  "name": "vevsdesign",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "node --localstorage-file=/tmp/vevsdesign-localstorage.json ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run audit:ci && npm run build",
    "audit:ci": "node scripts/audit.mjs",
    "start": "next start",
    "lint": "eslint",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5"
  }
}
